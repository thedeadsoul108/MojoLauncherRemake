<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/mojo_space_5">

    <TextView
        style="@style/TextAppearance.Mojo.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/browse_filter_title" />

    <TextView
        style="@style/TextAppearance.Mojo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_4"
        android:text="@string/browse_filter_version" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/search_mod_selected_mc_version_textview"
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="0dp"
            android:layout_height="@dimen/mojo_input_height"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:hint="@string/browse_version_any"
            android:maxLines="1"
            android:paddingStart="@dimen/mojo_space_4"
            android:paddingEnd="@dimen/mojo_space_4"
            tools:text="1.20.1" />

        <Button
            android:id="@+id/search_mod_mc_version_button"
            style="@style/Widget.Mojo.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mojo_input_height"
            android:layout_marginStart="@dimen/mojo_space_2"
            android:text="@string/editor_select" />
    </LinearLayout>

    <Button
        android:id="@+id/search_mod_apply_filters"
        style="@style/Widget.Mojo.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_button_height"
        android:layout_marginTop="@dimen/mojo_space_5"
        android:text="@string/browse_filter_apply" />

    <Button
        android:id="@+id/search_mod_clear_filters"
        style="@style/Widget.Mojo.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_button_height"
        android:layout_marginTop="@dimen/mojo_space_2"
        android:text="@string/browse_filter_clear" />
</LinearLayout>
