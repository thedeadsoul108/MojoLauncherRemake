<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top app bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_top_bar_height"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mojo_space_1"
        android:paddingEnd="@dimen/mojo_space_2">

        <ImageButton
            android:id="@+id/top_bar_back"
            style="@style/Widget.Mojo.IconButton"
            android:layout_width="@dimen/mojo_touch_target"
            android:layout_height="@dimen/mojo_touch_target"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_ui_back"
            android:tint="@color/text_primary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/top_bar_mark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/mojo_space_2"
            android:contentDescription="@string/app_logo_description"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:id="@+id/top_bar_title"
            style="@style/TextAppearance.Mojo.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mojo_space_3"
            android:layout_marginEnd="@dimen/mojo_space_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="20sp"
            tools:text="@string/nav_home" />

        <git.artdeell.mojo.ui.AccountChipView
            android:id="@+id/account_chip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mojo_touch_target"
            android:contentDescription="@string/top_bar_account" />
    </LinearLayout>

    <!-- Navigation rail + content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_rail"
            android:layout_width="@dimen/mojo_nav_rail_width"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_rail"
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_2"
            android:visibility="gone">

            <git.artdeell.mojo.ui.NavItemView
                android:id="@+id/nav_rail_home"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_nav_rail_item_height"
                android:layout_marginBottom="@dimen/mojo_space_1" />

            <git.artdeell.mojo.ui.NavItemView
                android:id="@+id/nav_rail_instances"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_nav_rail_item_height"
                android:layout_marginBottom="@dimen/mojo_space_1" />

            <git.artdeell.mojo.ui.NavItemView
                android:id="@+id/nav_rail_browse"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_nav_rail_item_height"
                android:layout_marginBottom="@dimen/mojo_space_1" />

            <git.artdeell.mojo.ui.NavItemView
                android:id="@+id/nav_rail_downloads"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_nav_rail_item_height"
                android:layout_marginBottom="@dimen/mojo_space_1" />

            <git.artdeell.mojo.ui.NavItemView
                android:id="@+id/nav_rail_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_nav_rail_item_height" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/container_fragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.kdt.mcgui.ProgressLayout
                android:id="@+id/progress_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation (phones) -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_bottom_nav_height"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mojo_space_1"
        android:paddingTop="@dimen/mojo_space_1"
        android:paddingEnd="@dimen/mojo_space_1"
        android:paddingBottom="@dimen/mojo_space_1">

        <git.artdeell.mojo.ui.NavItemView
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <git.artdeell.mojo.ui.NavItemView
            android:id="@+id/nav_instances"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <git.artdeell.mojo.ui.NavItemView
            android:id="@+id/nav_browse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <git.artdeell.mojo.ui.NavItemView
            android:id="@+id/nav_downloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <git.artdeell.mojo.ui.NavItemView
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Keeps every login/token-refresh/ExtraCore listener alive while the visible UI is custom. -->
    <com.kdt.mcgui.AccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
