<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_4"
        android:paddingEnd="@dimen/mojo_screen_padding">

        <TextView
            android:id="@+id/content_heading"
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Installed in Create: Astral" />

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_1"
            android:text="@string/content_intro" />

        <Button
            android:id="@+id/content_check_updates"
            style="@style/Widget.Mojo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_button_height"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:text="@string/content_check_updates" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/content_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/mojo_space_6"
                tools:listitem="@layout/view_content_entry" />

            <ProgressBar
                android:id="@+id/content_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/content_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/mojo_space_5"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/mojo_hero_icon"
                    android:layout_height="@dimen/mojo_hero_icon"
                    android:background="@drawable/bg_hero_icon"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/mojo_space_3"
                    android:src="@drawable/ic_ui_file" />

                <TextView
                    style="@style/TextAppearance.Mojo.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_3"
                    android:gravity="center"
                    android:text="@string/content_empty_title" />

                <TextView
                    style="@style/TextAppearance.Mojo.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_1"
                    android:gravity="center"
                    android:text="@string/content_empty_body"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
