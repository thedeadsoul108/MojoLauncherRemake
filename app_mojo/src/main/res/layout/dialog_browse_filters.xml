<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/mojo_space_5">

    <TextView
        style="@style/TextAppearance.Mojo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/browse_filter_version" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/browse_filter_version_value"
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/browse_version_any" />

        <Button
            android:id="@+id/browse_filter_version_button"
            style="@style/Widget.Mojo.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mojo_touch_target"
            android:text="@string/browse_filter_choose_version" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Mojo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_4"
        android:text="@string/browse_filter_loader" />

    <Spinner
        android:id="@+id/browse_filter_loader"
        style="@style/Widget.Mojo.Spinner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_input_height"
        android:layout_marginTop="@dimen/mojo_space_2" />

    <TextView
        style="@style/TextAppearance.Mojo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_4"
        android:text="@string/browse_filter_environment" />

    <Spinner
        android:id="@+id/browse_filter_environment"
        style="@style/Widget.Mojo.Spinner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_input_height"
        android:layout_marginTop="@dimen/mojo_space_2" />

    <TextView
        style="@style/TextAppearance.Mojo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_4"
        android:text="@string/browse_filter_category" />

    <EditText
        android:id="@+id/browse_filter_category"
        style="@style/Widget.Mojo.Input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mojo_input_height"
        android:layout_marginTop="@dimen/mojo_space_2"
        android:hint="@string/browse_filter_category_hint"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        style="@style/TextAppearance.Mojo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_3"
        android:text="@string/browse_filter_category_note"
        android:textColor="@color/text_muted" />
</LinearLayout>
