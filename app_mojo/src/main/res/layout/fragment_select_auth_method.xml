<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_6"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_title"
            android:textSize="26sp" />

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:text="@string/auth_subtitle"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            style="@style/Widget.Mojo.SectionCard"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:orientation="vertical">

            <Button
                android:id="@+id/button_microsoft_authentication"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:contentDescription="@string/auth_microsoft_body"
                android:text="@string/auth_select_microsoft" />

            <TextView
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:text="@string/auth_microsoft_body" />

            <Button
                android:id="@+id/button_elyby_authentication"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_5"
                android:contentDescription="@string/auth_elyby_body"
                android:text="@string/auth_select_elyby" />

            <TextView
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:text="@string/auth_elyby_body" />

            <Button
                android:id="@+id/button_local_authentication"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_5"
                android:contentDescription="@string/auth_local_body"
                android:text="@string/auth_select_local" />

            <TextView
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:text="@string/auth_local_body" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_5"
            android:gravity="center"
            android:text="@string/auth_legal_note"
            android:textColor="@color/text_muted"
            tools:text="@string/auth_legal_note" />
    </LinearLayout>
</com.kdt.DefocusableScrollView>
