<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/mojo_space_5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/content_detail_icon"
                android:layout_width="@dimen/mojo_hero_icon"
                android:layout_height="@dimen/mojo_hero_icon"
                android:background="@drawable/bg_hero_icon"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:padding="@dimen/mojo_space_2"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ui_box"
                android:tint="@color/text_muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/content_detail_title"
                    style="@style/TextAppearance.Mojo.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Sodium" />

                <TextView
                    android:id="@+id/content_detail_author"
                    style="@style/TextAppearance.Mojo.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="CaffeineMC" />

                <TextView
                    android:id="@+id/content_detail_stats"
                    style="@style/TextAppearance.Mojo.Badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_1"
                    android:textColor="@color/text_muted"
                    tools:text="12,345 downloads" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/content_detail_description"
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:textColor="@color/text_secondary"
            tools:text="A modern rendering engine for Minecraft which greatly improves performance" />

        <TextView
            android:id="@+id/content_detail_body"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_5"
            android:text="@string/browse_detail_version" />

        <Spinner
            android:id="@+id/content_detail_version"
            style="@style/Widget.Mojo.Spinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_input_height"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:visibility="gone"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/content_detail_progress"
            style="@style/Widget.Mojo.LinearProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/content_detail_error"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:textColor="@color/danger"
            android:visibility="gone"
            tools:text="@string/browse_detail_versions_error"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/content_detail_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:background="@drawable/bg_card_flat"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mojo_space_3">

            <TextView
                android:id="@+id/content_detail_target_text"
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Installing into Fabulously Optimized" />

            <Button
                android:id="@+id/content_detail_target_action"
                style="@style/Widget.Mojo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/mojo_touch_target"
                android:text="@string/browse_choose_instance"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
