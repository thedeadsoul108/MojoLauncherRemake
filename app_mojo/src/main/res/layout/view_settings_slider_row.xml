<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/mojo_space_3"
    android:paddingTop="@dimen/mojo_space_3"
    android:paddingEnd="@dimen/mojo_space_3"
    android:paddingBottom="@dimen/mojo_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settings_slider_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_hero_icon"
            android:importantForAccessibility="no"
            android:padding="@dimen/mojo_space_2"
            android:src="@drawable/ic_px_sliders"
            android:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mojo_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settings_slider_title"
                style="@style/TextAppearance.Mojo.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Slider title" />

            <TextView
                android:id="@+id/settings_slider_summary"
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Slider description text" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_slider_value_badge"
            style="@style/TextAppearance.Mojo.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mojo_space_2"
            android:background="@drawable/bg_badge_accent"
            android:paddingStart="@dimen/mojo_space_2"
            android:paddingTop="3dp"
            android:paddingEnd="@dimen/mojo_space_2"
            android:paddingBottom="3dp"
            android:textColor="@color/accent"
            tools:text="100 %" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/settings_slider_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_2" />

    <LinearLayout
        android:id="@+id/settings_slider_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mojo_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
