<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_5"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:text="@string/settings_section_appearance" />

        <LinearLayout
            android:id="@+id/settings_appearance_container"
            style="@style/Widget.Mojo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_1" />

        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:text="@string/settings_section_accounts" />

        <LinearLayout
            android:id="@+id/settings_accounts_container"
            style="@style/Widget.Mojo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_1" />

        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:text="@string/settings_section_gameplay" />

        <LinearLayout
            android:id="@+id/settings_gameplay_container"
            style="@style/Widget.Mojo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_1" />

        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:text="@string/settings_section_tools" />

        <LinearLayout
            android:id="@+id/settings_tools_container"
            style="@style/Widget.Mojo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_1" />

        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:text="@string/settings_section_about" />

        <LinearLayout
            android:id="@+id/settings_about_container"
            style="@style/Widget.Mojo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_1" />

        <TextView
            android:id="@+id/settings_version_footer"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_8"
            android:gravity="center"
            android:textColor="@color/text_muted"
            tools:text="MojoRemake v1.0.1 · debug" />
    </LinearLayout>
</com.kdt.DefocusableScrollView>
