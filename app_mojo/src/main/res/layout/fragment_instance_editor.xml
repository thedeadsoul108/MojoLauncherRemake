<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/editor_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible"
        tools:visibility="visible">

        <com.kdt.DefocusableScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/mojo_screen_padding"
                android:paddingTop="@dimen/mojo_space_4"
                android:paddingEnd="@dimen/mojo_screen_padding"
                android:paddingBottom="@dimen/mojo_space_6">

                <!-- General -->
                <LinearLayout
                    style="@style/Widget.Mojo.SectionCard"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_section_general" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/editor_icon"
                            android:layout_width="@dimen/mojo_instance_icon_large"
                            android:layout_height="@dimen/mojo_instance_icon_large"
                            android:background="@drawable/bg_hero_icon"
                            android:clickable="true"
                            android:contentDescription="@string/editor_icon_description"
                            android:focusable="true"
                            android:padding="@dimen/mojo_space_2"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/ic_ui_instance_default" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mojo_space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/editor_change_icon"
                                style="@style/Widget.Mojo.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/mojo_touch_target"
                                android:minHeight="@dimen/mojo_touch_target"
                                android:text="@string/editor_change_icon" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_4"
                        android:text="@string/editor_name_label" />

                    <EditText
                        android:id="@+id/editor_name"
                        style="@style/Widget.Mojo.Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mojo_input_height"
                        android:layout_marginTop="@dimen/mojo_space_1"
                        android:hint="@string/editor_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/editor_name_helper"
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_1"
                        android:text="@string/editor_name_helper" />
                </LinearLayout>

                <!-- Version and loader -->
                <LinearLayout
                    style="@style/Widget.Mojo.SectionCard"
                    android:layout_marginTop="@dimen/mojo_space_3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_section_version" />

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_4"
                        android:text="@string/editor_version_label" />

                    <LinearLayout
                        android:id="@+id/editor_version_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mojo_input_height"
                        android:layout_marginTop="@dimen/mojo_space_1"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/mojo_space_4"
                        android:paddingEnd="@dimen/mojo_space_4">

                        <TextView
                            android:id="@+id/editor_version_value"
                            style="@style/TextAppearance.Mojo.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/editor_version_hint" />

                        <ImageView
                            android:layout_width="@dimen/mojo_icon_size_small"
                            android:layout_height="@dimen/mojo_icon_size_small"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ui_chevron_right"
                            android:tint="@color/text_muted" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_3"
                        android:text="@string/editor_loader_label" />

                    <TextView
                        android:id="@+id/editor_loader_value"
                        style="@style/TextAppearance.Mojo.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="Vanilla" />

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_3"
                        android:text="@string/editor_runtime_label" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/editor_runtime"
                        style="@style/Widget.Mojo.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mojo_input_height"
                        android:layout_marginTop="@dimen/mojo_space_1" />

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_3"
                        android:text="@string/editor_renderer_label" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/editor_renderer"
                        style="@style/Widget.Mojo.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mojo_input_height"
                        android:layout_marginTop="@dimen/mojo_space_1" />

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_3"
                        android:text="@string/editor_control_label" />

                    <LinearLayout
                        android:id="@+id/editor_control_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mojo_input_height"
                        android:layout_marginTop="@dimen/mojo_space_1"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/mojo_space_4"
                        android:paddingEnd="@dimen/mojo_space_4">

                        <TextView
                            android:id="@+id/editor_control_value"
                            style="@style/TextAppearance.Mojo.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text="@string/editor_control_default" />

                        <ImageView
                            android:layout_width="@dimen/mojo_icon_size_small"
                            android:layout_height="@dimen/mojo_icon_size_small"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ui_chevron_right"
                            android:tint="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Performance -->
                <LinearLayout
                    style="@style/Widget.Mojo.SectionCard"
                    android:layout_marginTop="@dimen/mojo_space_3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_section_performance" />

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_4"
                        android:text="@string/editor_jvm_label" />

                    <EditText
                        android:id="@+id/editor_jvm"
                        style="@style/Widget.Mojo.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_1"
                        android:gravity="top|start"
                        android:hint="@string/editor_jvm_hint"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:maxLines="4"
                        android:minHeight="80dp"
                        android:paddingTop="@dimen/mojo_space_3"
                        android:paddingBottom="@dimen/mojo_space_3" />
                </LinearLayout>

                <!-- Storage -->
                <LinearLayout
                    style="@style/Widget.Mojo.SectionCard"
                    android:layout_marginTop="@dimen/mojo_space_3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_section_storage" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Mojo.CardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editor_shared_data_title" />

                            <TextView
                                android:id="@+id/editor_shared_data_body"
                                style="@style/TextAppearance.Mojo.Meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/editor_shared_data_body" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/editor_shared_data"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mojo_space_3"
                            android:contentDescription="@string/editor_shared_data_title" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Danger -->
                <LinearLayout
                    style="@style/Widget.Mojo.SectionCard"
                    android:layout_marginTop="@dimen/mojo_space_3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_section_danger" />

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mojo_space_2"
                        android:text="@string/editor_delete_body" />

                    <Button
                        android:id="@+id/editor_delete"
                        style="@style/Widget.Mojo.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mojo_button_height"
                        android:layout_marginTop="@dimen/mojo_space_4"
                        android:text="@string/editor_delete_button" />
                </LinearLayout>
            </LinearLayout>
        </com.kdt.DefocusableScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_4">

            <Button
                android:id="@+id/editor_save"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:text="@string/editor_save" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/editor_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />
</FrameLayout>
