<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/mojo_space_3"
    android:paddingTop="@dimen/mojo_space_2"
    android:paddingEnd="@dimen/mojo_space_2"
    android:paddingBottom="@dimen/mojo_space_2">

    <ImageView
        android:id="@+id/settings_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_hero_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/mojo_space_2"
        android:src="@drawable/ic_ui_settings"
        android:tint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mojo_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_row_title"
            style="@style/TextAppearance.Mojo.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Video and renderer" />

        <TextView
            android:id="@+id/settings_row_summary"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Resolution, renderer and performance" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/mojo_icon_size_small"
        android:layout_height="@dimen/mojo_icon_size_small"
        android:layout_marginStart="@dimen/mojo_space_2"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ui_chevron_right"
        android:tint="@color/text_muted" />
</LinearLayout>
