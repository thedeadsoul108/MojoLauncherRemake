<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_4"
        android:paddingEnd="@dimen/mojo_screen_padding">

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instances_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/instances_count"
                style="@style/TextAppearance.Mojo.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="3 instances" />

            <Button
                android:id="@+id/instances_import"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/mojo_touch_target"
                android:minHeight="@dimen/mojo_touch_target"
                android:text="@string/instances_import" />

            <Button
                android:id="@+id/instances_create"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/mojo_touch_target"
                android:layout_marginStart="@dimen/mojo_space_2"
                android:minHeight="@dimen/mojo_touch_target"
                android:text="@string/instances_create" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/instances_search"
                style="@style/Widget.Mojo.Input"
                android:layout_width="0dp"
                android:layout_height="@dimen/mojo_input_height"
                android:layout_weight="1"
                android:hint="@string/instances_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/instances_sort"
                style="@style/Widget.Mojo.IconButton"
                android:layout_width="@dimen/mojo_touch_target"
                android:layout_height="@dimen/mojo_touch_target"
                android:layout_marginStart="@dimen/mojo_space_1"
                android:contentDescription="@string/instances_sort"
                android:src="@drawable/ic_ui_sort"
                android:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/mojo_space_2"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/instances_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/mojo_screen_padding"
            android:paddingTop="@dimen/mojo_space_1"
            android:paddingEnd="@dimen/mojo_screen_padding"
            android:paddingBottom="@dimen/mojo_space_6"
            tools:listitem="@layout/view_instance_card" />

        <com.kdt.DefocusableScrollView
            android:id="@+id/instances_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/mojo_space_6">

                <ImageView
                    android:layout_width="@dimen/mojo_hero_icon"
                    android:layout_height="@dimen/mojo_hero_icon"
                    android:background="@drawable/bg_hero_icon"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/mojo_space_3"
                    android:src="@drawable/ic_ui_instances"
                    android:tint="@color/accent" />

                <TextView
                    android:id="@+id/instances_empty_title"
                    style="@style/TextAppearance.Mojo.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_4"
                    android:gravity="center"
                    android:text="@string/instances_empty_title" />

                <TextView
                    android:id="@+id/instances_empty_body"
                    style="@style/TextAppearance.Mojo.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_2"
                    android:gravity="center"
                    android:text="@string/instances_empty_body"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/instances_empty_create"
                    style="@style/Widget.Mojo.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mojo_button_height"
                    android:layout_marginTop="@dimen/mojo_space_5"
                    android:text="@string/instances_create" />

                <Button
                    android:id="@+id/instances_empty_import"
                    style="@style/Widget.Mojo.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mojo_button_height"
                    android:layout_marginTop="@dimen/mojo_space_2"
                    android:text="@string/instances_import" />
            </LinearLayout>
        </com.kdt.DefocusableScrollView>

        <com.kdt.DefocusableScrollView
            android:id="@+id/instances_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/mojo_space_6">

                <ImageView
                    android:layout_width="@dimen/mojo_hero_icon"
                    android:layout_height="@dimen/mojo_hero_icon"
                    android:background="@drawable/bg_hero_icon"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/mojo_space_3"
                    android:src="@drawable/ic_ui_warning"
                    android:tint="@color/warning" />

                <TextView
                    style="@style/TextAppearance.Mojo.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_4"
                    android:gravity="center"
                    android:text="@string/instances_error_title" />

                <TextView
                    style="@style/TextAppearance.Mojo.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mojo_space_2"
                    android:gravity="center"
                    android:text="@string/instances_error_body"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/instances_retry"
                    style="@style/Widget.Mojo.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mojo_button_height"
                    android:layout_marginTop="@dimen/mojo_space_5"
                    android:text="@string/action_retry" />
            </LinearLayout>
        </com.kdt.DefocusableScrollView>
    </FrameLayout>
</LinearLayout>
