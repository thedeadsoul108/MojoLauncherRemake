<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/mojo_space_4"
    android:paddingBottom="@dimen/mojo_space_2">

    <TextView
        android:id="@+id/content_header_title"
        style="@style/TextAppearance.Mojo.SectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Mods" />

    <TextView
        android:id="@+id/content_header_count"
        style="@style/TextAppearance.Mojo.Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        tools:text="12" />
</LinearLayout>
