<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_action_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:padding="@dimen/mojo_space_4">

    <ImageView
        android:id="@+id/action_tile_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_hero_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/mojo_space_2"
        android:src="@drawable/ic_ui_add"
        android:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mojo_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/action_tile_title"
            style="@style/TextAppearance.Mojo.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="New instance" />

        <TextView
            android:id="@+id/action_tile_body"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Vanilla or modded" />
    </LinearLayout>
</LinearLayout>
