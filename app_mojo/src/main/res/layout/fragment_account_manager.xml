<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_5"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accounts_subtitle"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/accounts_add"
            style="@style/Widget.Mojo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_button_height"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:text="@string/accounts_add" />

        <ProgressBar
            android:id="@+id/accounts_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:indeterminateTint="@color/accent" />

        <LinearLayout
            android:id="@+id/accounts_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_5"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_1"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/accounts_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_5"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_6"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/mojo_hero_icon"
                android:layout_height="@dimen/mojo_hero_icon"
                android:background="@drawable/bg_avatar"
                android:importantForAccessibility="no"
                android:padding="@dimen/mojo_space_3"
                android:src="@drawable/ic_ui_person_add"
                android:tint="@color/accent" />

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_4"
                android:gravity="center"
                android:text="@string/accounts_empty_title" />

            <TextView
                style="@style/TextAppearance.Mojo.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:gravity="center"
                android:text="@string/accounts_empty_body"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/accounts_empty_add"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_5"
                android:text="@string/accounts_add" />
        </LinearLayout>
    </LinearLayout>
</com.kdt.DefocusableScrollView>
