<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_5"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skin_subtitle"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mojo_space_3">

            <ImageView
                android:id="@+id/skin_account_avatar"
                android:layout_width="@dimen/mojo_instance_icon_small"
                android:layout_height="@dimen/mojo_instance_icon_small"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/skin_account_avatar_description"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ui_person"
                android:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/skin_account_name"
                    style="@style/TextAppearance.Mojo.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="MojoPlayer" />

                <TextView
                    android:id="@+id/skin_account_type"
                    style="@style/TextAppearance.Mojo.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Microsoft account" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:background="@drawable/bg_card">

            <ImageView
                android:id="@+id/skin_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/skin_preview_description"
                android:padding="@dimen/mojo_space_4"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/skin_preview_loading"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/skin_preview_empty"
                style="@style/TextAppearance.Mojo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/mojo_space_5"
                android:text="@string/skin_preview_empty"
                android:textColor="@color/text_muted"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:text="@string/skin_model"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/skin_variant_classic"
                style="@style/Widget.Mojo.Chip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/mojo_space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selectable"
                android:text="@string/skin_model_classic"
                android:textAllCaps="false"
                android:textColor="@color/chip_text" />

            <Button
                android:id="@+id/skin_variant_slim"
                style="@style/Widget.Mojo.Chip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selectable"
                android:text="@string/skin_model_slim"
                android:textAllCaps="false"
                android:textColor="@color/chip_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/skin_source"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:textColor="@color/text_muted"
            tools:text="Previewing a local file" />

        <Button
            android:id="@+id/skin_choose"
            style="@style/Widget.Mojo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_button_height"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:text="@string/skin_choose_file" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/skin_from_url"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginEnd="@dimen/mojo_space_2"
                android:layout_weight="1"
                android:text="@string/skin_from_url" />

            <Button
                android:id="@+id/skin_copy_player"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_weight="1"
                android:text="@string/skin_copy_player" />
        </LinearLayout>

        <Button
            android:id="@+id/skin_reset"
            style="@style/Widget.Mojo.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_button_height"
            android:layout_marginTop="@dimen/mojo_space_1"
            android:text="@string/skin_use_account" />

        <Button
            android:id="@+id/skin_apply"
            style="@style/Widget.Mojo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_button_height"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:text="@string/skin_apply" />

        <TextView
            android:id="@+id/skin_status"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:minHeight="@dimen/mojo_touch_target"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="Skin applied"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:background="@color/border" />

        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_5"
            android:text="@string/skin_cape_title" />

        <TextView
            android:id="@+id/skin_cape_note"
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:textColor="@color/text_secondary"
            tools:text="Minecraft does not provide a public API for changing capes." />

        <LinearLayout
            android:id="@+id/skin_cape_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:orientation="vertical" />

        <Button
            android:id="@+id/skin_manage_elyby"
            style="@style/Widget.Mojo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mojo_button_height"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:text="@string/skin_manage_elyby"
            android:visibility="gone" />
    </LinearLayout>
</com.kdt.DefocusableScrollView>
