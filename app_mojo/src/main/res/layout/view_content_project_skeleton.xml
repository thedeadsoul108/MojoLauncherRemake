<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/mojo_space_2"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/mojo_space_3">

    <View
        android:layout_width="@dimen/mojo_instance_icon"
        android:layout_height="@dimen/mojo_instance_icon"
        android:background="@drawable/bg_skeleton" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mojo_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="160dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="96dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:background="@drawable/bg_skeleton" />

        <View
            android:layout_width="220dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/mojo_space_1"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</LinearLayout>
