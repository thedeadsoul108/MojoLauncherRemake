<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="@dimen/mojo_space_4">

    <ImageView
        android:id="@+id/create_option_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_hero_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/mojo_space_2"
        android:src="@drawable/ic_ui_box"
        android:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mojo_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/create_option_title"
            style="@style/TextAppearance.Mojo.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/create_option_body"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/mojo_icon_size_small"
        android:layout_height="@dimen/mojo_icon_size_small"
        android:layout_marginStart="@dimen/mojo_space_2"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ui_chevron_right"
        android:tint="@color/text_muted" />
</LinearLayout>
