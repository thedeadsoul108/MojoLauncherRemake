<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_5"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/home_eyebrow"
            android:textColor="@color/accent" />

        <TextView
            style="@style/TextAppearance.Mojo.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:text="@string/home_title" />

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:text="@string/home_subtitle"
            android:textColor="@color/text_secondary" />

        <!-- Selected instance -->
        <LinearLayout
            android:id="@+id/home_instance_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:background="@drawable/bg_card_hero"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_5">

            <TextView
                style="@style/TextAppearance.Mojo.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/home_selected_label"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_instance_icon"
                    android:layout_width="@dimen/mojo_hero_icon"
                    android:layout_height="@dimen/mojo_hero_icon"
                    android:background="@drawable/bg_hero_icon"
                    android:contentDescription="@string/content_desc_instance_icon"
                    android:padding="@dimen/mojo_space_2"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_ui_instance_default" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mojo_space_4"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_instance_name"
                        style="@style/TextAppearance.Mojo.ScreenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="22sp"
                        tools:text="Create: Astral" />

                    <TextView
                        android:id="@+id/home_instance_meta"
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="1.20.1 · Fabric" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Mojo.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_accent"
                    android:paddingStart="@dimen/mojo_space_2"
                    android:paddingEnd="@dimen/mojo_space_2"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/home_selected_badge"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <Button
                android:id="@+id/home_play"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/mojo_space_4"
                android:drawableStart="@drawable/ic_ui_play"
                android:drawablePadding="@dimen/mojo_space_2"
                android:drawableTint="@color/on_accent"
                android:letterSpacing="0.08"
                android:text="@string/home_play"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_switch"
                    style="@style/Widget.Mojo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/mojo_button_height"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_ui_chevron_down"
                    android:drawablePadding="@dimen/mojo_space_1"
                    android:drawableTint="@color/text_primary"
                    android:paddingStart="@dimen/mojo_space_2"
                    android:paddingEnd="@dimen/mojo_space_2"
                    android:text="@string/home_switch_instance" />

                <Button
                    android:id="@+id/home_mods"
                    style="@style/Widget.Mojo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/mojo_button_height"
                    android:layout_marginStart="@dimen/mojo_space_2"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_ui_box"
                    android:drawablePadding="@dimen/mojo_space_1"
                    android:drawableTint="@color/text_primary"
                    android:paddingStart="@dimen/mojo_space_2"
                    android:paddingEnd="@dimen/mojo_space_2"
                    android:text="@string/home_manage_mods" />

                <Button
                    android:id="@+id/home_configure"
                    style="@style/Widget.Mojo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/mojo_button_height"
                    android:layout_marginStart="@dimen/mojo_space_2"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_ui_edit"
                    android:drawablePadding="@dimen/mojo_space_1"
                    android:drawableTint="@color/text_primary"
                    android:paddingStart="@dimen/mojo_space_2"
                    android:paddingEnd="@dimen/mojo_space_2"
                    android:text="@string/home_configure" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hardware & System Specs -->
        <LinearLayout
            android:id="@+id/home_system_card"
            style="@style/Widget.Mojo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_4">

            <TextView
                style="@style/TextAppearance.Mojo.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/settings_section_system"
                android:textColor="@color/text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_3"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_stat_ram_label"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/home_stat_ram"
                        style="@style/TextAppearance.Mojo.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        tools:text="2048 MB" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mojo_space_2"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_stat_gpu_label"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/home_stat_gpu"
                        style="@style/TextAppearance.Mojo.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        tools:text="Vulkan 1.0+" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mojo_space_2"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Mojo.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_stat_storage_label"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/home_stat_storage"
                        style="@style/TextAppearance.Mojo.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        tools:text="34.8 GB Free" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/home_empty_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_5"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/mojo_hero_icon"
                android:layout_height="@dimen/mojo_hero_icon"
                android:background="@drawable/bg_hero_icon"
                android:importantForAccessibility="no"
                android:padding="@dimen/mojo_space_3"
                android:src="@drawable/ic_ui_instances"
                android:tint="@color/accent" />

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_3"
                android:text="@string/home_no_instance_title" />

            <TextView
                style="@style/TextAppearance.Mojo.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_1"
                android:text="@string/home_no_instance_body"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/home_empty_create"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_4"
                android:text="@string/home_create_instance" />
        </LinearLayout>

        <!-- Quick actions -->
        <TextView
            style="@style/TextAppearance.Mojo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:text="@string/home_quick_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:orientation="horizontal">

            <include
                android:id="@+id/home_action_create"
                layout="@layout/view_action_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/home_action_browse"
                layout="@layout/view_action_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_3"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:orientation="horizontal">

            <include
                android:id="@+id/home_action_controls"
                layout="@layout/view_action_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/home_action_settings"
                layout="@layout/view_action_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_3"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Recent instances -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent_title" />

            <Button
                android:id="@+id/home_recent_all"
                style="@style/Widget.Mojo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/mojo_touch_target"
                android:text="@string/home_recent_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/home_recent_empty"
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:text="@string/home_recent_empty"
            android:visibility="gone" />

        <!-- Account -->
        <LinearLayout
            android:id="@+id/home_account_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:background="@drawable/bg_card_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mojo_card_padding">

            <ImageView
                android:id="@+id/home_account_icon"
                android:layout_width="@dimen/mojo_instance_icon_small"
                android:layout_height="@dimen/mojo_instance_icon_small"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/content_desc_account_avatar"
                android:padding="@dimen/mojo_space_2"
                android:src="@drawable/ic_ui_person"
                android:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_account_name"
                    style="@style/TextAppearance.Mojo.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="MojoPlayer" />

                <TextView
                    android:id="@+id/home_account_type"
                    style="@style/TextAppearance.Mojo.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_accounts_summary" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/mojo_icon_size_small"
                android:layout_height="@dimen/mojo_icon_size_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_chevron_right"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Downloads -->
        <LinearLayout
            android:id="@+id/home_downloads_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:background="@drawable/bg_card_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mojo_card_padding"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/mojo_instance_icon_small"
                android:layout_height="@dimen/mojo_instance_icon_small"
                android:background="@drawable/bg_hero_icon"
                android:importantForAccessibility="no"
                android:padding="@dimen/mojo_space_2"
                android:src="@drawable/ic_ui_downloads"
                android:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Mojo.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_tasks_title" />

                <TextView
                    android:id="@+id/home_tasks_count"
                    style="@style/TextAppearance.Mojo.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="2 active" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Mojo.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_info"
                android:paddingStart="@dimen/mojo_space_2"
                android:paddingEnd="@dimen/mojo_space_2"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/home_tasks_open"
                android:textColor="@color/info" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_8"
            android:gravity="center"
            android:text="@string/home_footer"
            android:textColor="@color/text_muted" />
    </LinearLayout>
</com.kdt.DefocusableScrollView>
