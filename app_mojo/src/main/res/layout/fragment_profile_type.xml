<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.kdt.DefocusableScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/mojo_screen_padding"
            android:paddingTop="@dimen/mojo_space_5"
            android:paddingEnd="@dimen/mojo_screen_padding"
            android:paddingBottom="@dimen/mojo_space_8">

            <TextView
                style="@style/TextAppearance.Mojo.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_subtitle"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_6"
                android:text="@string/create_section_start" />

            <include
                android:id="@+id/create_vanilla"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_3" />

            <include
                android:id="@+id/create_optifine"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_6"
                android:text="@string/create_section_loaders" />

            <include
                android:id="@+id/create_fabric"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_3" />

            <include
                android:id="@+id/create_quilt"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />

            <include
                android:id="@+id/create_legacy_fabric"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />

            <include
                android:id="@+id/create_forge"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />

            <include
                android:id="@+id/create_neoforge"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />

            <include
                android:id="@+id/create_bta"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_6"
                android:text="@string/create_section_modpacks" />

            <include
                android:id="@+id/create_modpack"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_3" />

            <include
                android:id="@+id/create_import"
                layout="@layout/view_create_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2" />
        </LinearLayout>
    </com.kdt.DefocusableScrollView>

    <FrameLayout
        android:id="@+id/create_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />
    </FrameLayout>
</FrameLayout>
