<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_5"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/downloads_subtitle"
            android:textColor="@color/text_secondary" />

        <!-- Contextual notification permission card -->
        <LinearLayout
            android:id="@+id/downloads_notification_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_5"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/mojo_card_padding"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_hero_icon"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/mojo_space_2"
                    android:src="@drawable/ic_ui_notifications"
                    android:tint="@color/warning" />

                <TextView
                    style="@style/TextAppearance.Mojo.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mojo_space_3"
                    android:layout_weight="1"
                    android:text="@string/downloads_notification_title" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:text="@string/downloads_notification_body" />

            <Button
                android:id="@+id/downloads_notification_action"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_4"
                android:text="@string/downloads_notification_allow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloads_notifications_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:background="@drawable/bg_section_note"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/mojo_space_3"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/mojo_icon_size_small"
                android:layout_height="@dimen/mojo_icon_size_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_check_circle"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/downloads_notifications_enabled_text"
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mojo_space_2"
                android:layout_weight="1"
                android:text="@string/downloads_notification_note" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/downloads_active_title" />

            <TextView
                android:id="@+id/downloads_count"
                style="@style/TextAppearance.Mojo.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_info"
                android:paddingStart="@dimen/mojo_space_2"
                android:paddingEnd="@dimen/mojo_space_2"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/info"
                android:visibility="gone"
                tools:text="2 active"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloads_tasks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/downloads_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_3"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/mojo_space_6"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/mojo_hero_icon"
                android:layout_height="@dimen/mojo_hero_icon"
                android:background="@drawable/bg_hero_icon"
                android:importantForAccessibility="no"
                android:padding="@dimen/mojo_space_3"
                android:src="@drawable/ic_ui_downloads"
                android:tint="@color/accent" />

            <TextView
                style="@style/TextAppearance.Mojo.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_4"
                android:gravity="center"
                android:text="@string/downloads_empty_title" />

            <TextView
                style="@style/TextAppearance.Mojo.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mojo_space_2"
                android:gravity="center"
                android:text="@string/downloads_empty_body"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/downloads_empty_browse"
                style="@style/Widget.Mojo.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_4"
                android:text="@string/downloads_empty_action" />
        </LinearLayout>
    </LinearLayout>
</com.kdt.DefocusableScrollView>
