<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mojo_screen_padding"
        android:paddingTop="@dimen/mojo_space_6"
        android:paddingEnd="@dimen/mojo_screen_padding"
        android:paddingBottom="@dimen/mojo_space_8">

        <TextView
            style="@style/TextAppearance.Mojo.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_login_title"
            android:textSize="26sp" />

        <TextView
            style="@style/TextAppearance.Mojo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_2"
            android:text="@string/local_login_subtitle"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            style="@style/Widget.Mojo.SectionCard"
            android:layout_marginTop="@dimen/mojo_space_6"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Mojo.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_online_username_hint" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/login_edit_email"
                style="@style/Widget.Mojo.Input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_input_height"
                android:layout_marginTop="@dimen/mojo_space_1"
                android:hint="@string/login_online_username_hint"
                android:imeOptions="flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />

            <Button
                android:id="@+id/login_button"
                style="@style/Widget.Mojo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mojo_button_height"
                android:layout_marginTop="@dimen/mojo_space_5"
                android:text="@string/local_login_button" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Mojo.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mojo_space_4"
            android:text="@string/local_login_note"
            android:textColor="@color/text_muted"
            tools:text="@string/local_login_note" />
    </LinearLayout>
</com.kdt.DefocusableScrollView>
